<Window
    x:Class="UCAD.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:UCAD.Views">

    <Grid x:Name="RootLayout" KeyDown="RootLayout_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton x:Uid="LineButton" Icon="Add" Click="Line_Click" />
            <AppBarButton x:Uid="PolylineButton" Click="Polyline_Click" />
            <AppBarButton x:Uid="RectangleButton" Click="Rectangle_Click" />
            <AppBarButton x:Uid="CircleButton" Click="Circle_Click" />
            <AppBarButton x:Uid="ArcButton" Click="Arc_Click" />
            <AppBarSeparator />
            <AppBarButton x:Name="UndoButton" x:Uid="UndoButton" IsEnabled="False" Click="Undo_Click" />
            <AppBarButton x:Name="RedoButton" x:Uid="RedoButton" IsEnabled="False" Click="Redo_Click" />
            <AppBarSeparator />
            <AppBarButton x:Uid="ClearButton" Icon="Delete" Click="Clear_Click" />
            <AppBarButton x:Uid="ResetViewButton" Icon="Refresh" Click="ResetView_Click" />
        </CommandBar>

        <views:CadViewport x:Name="Viewport" Grid.Row="1" />

        <Border Grid.Row="2" Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="CommandPrompt" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontWeight="SemiBold" />
                <TextBox
                    x:Name="CommandInput"
                    x:Uid="CommandInput"
                    Grid.Column="1"
                    MinHeight="32"
                    Padding="8,3"
                    FontFamily="Cascadia Mono"
                    KeyDown="CommandInput_KeyDown" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ModeText" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="UCAD v0.3" Margin="20,0" Opacity="0.7" />
                <TextBlock x:Name="CoordinateText" Grid.Column="2" HorizontalAlignment="Right" Text="X 0.00  Y 0.00" FontFamily="Cascadia Mono" />
            </Grid>
        </Border>
    </Grid>
</Window>
