<Window
    x:Class="UCAD.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" KeyDown="RootLayout_KeyDown">
        <Grid.Resources>
            <Style x:Key="ShellMenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,5" />
            </Style>
            <Style x:Key="CategoryButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,5" />
            </Style>
            <Style x:Key="ToolShelfButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Width" Value="78" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Padding" Value="4,2" />
            </Style>
            <Style x:Key="ToolRailButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="InspectorTabStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="10,5" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="44"
            Title="UCAD"
            HorizontalContentAlignment="Stretch">
            <TitleBar.Content>
                <TabView
                    x:Name="DocumentTabs"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    IsAddTabButtonVisible="True"
                    TabWidthMode="SizeToContent"
                    CloseButtonOverlayMode="OnPointerOver"
                    AddTabButtonClick="DocumentTabs_AddTabButtonClick"
                    SelectionChanged="DocumentTabs_SelectionChanged"
                    TabCloseRequested="DocumentTabs_TabCloseRequested" />
            </TitleBar.Content>
        </TitleBar>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Button x:Uid="FileMenuButton" Grid.Column="0" Style="{StaticResource ShellMenuButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="NewDrawingMenuItem" Click="NewDrawingMenuItem_Click" />
                            <MenuFlyoutItem x:Uid="CloseDrawingMenuItem" Click="CloseDrawingMenuItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Uid="EditMenuButton" Grid.Column="1" Style="{StaticResource ShellMenuButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="UndoMenuItem" x:Uid="UndoMenuItem" Tag="UNDO" Click="RunCommand_Click" />
                            <MenuFlyoutItem x:Name="RedoMenuItem" x:Uid="RedoMenuItem" Tag="REDO" Click="RunCommand_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="ClearMenuItem" Tag="CLEAR" Click="RunCommand_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Uid="ViewMenuButton" Grid.Column="2" Style="{StaticResource ShellMenuButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="ResetViewMenuItem" Tag="RESETVIEW" Click="RunCommand_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Rectangle Grid.Column="3" Width="1" Height="24" Margin="6,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ToggleButton
                    x:Name="DrawCategoryButton"
                    x:Uid="DrawCategoryButton"
                    Grid.Column="4"
                    IsChecked="True"
                    Style="{StaticResource CategoryButtonStyle}"
                    Click="DrawCategoryButton_Click" />
                <ToggleButton x:Uid="ModifyCategoryButton" Grid.Column="5" IsEnabled="False" Style="{StaticResource CategoryButtonStyle}" />
                <ToggleButton x:Uid="AnnotateCategoryButton" Grid.Column="6" IsEnabled="False" Style="{StaticResource CategoryButtonStyle}" />
                <ToggleButton x:Uid="LayersCategoryButton" Grid.Column="7" IsEnabled="False" Style="{StaticResource CategoryButtonStyle}" />
                <ToggleButton x:Uid="BlocksCategoryButton" Grid.Column="8" IsEnabled="False" Style="{StaticResource CategoryButtonStyle}" />
                <ToggleButton x:Uid="MeasureCategoryButton" Grid.Column="9" IsEnabled="False" Style="{StaticResource CategoryButtonStyle}" />
                <ToggleButton
                    x:Name="ViewCategoryButton"
                    x:Uid="ViewCategoryButton"
                    Grid.Column="10"
                    Style="{StaticResource CategoryButtonStyle}"
                    Click="ViewCategoryButton_Click" />

                <AutoSuggestBox
                    x:Name="CommandSearch"
                    x:Uid="CommandSearch"
                    Grid.Column="12"
                    Height="30"
                    MinWidth="180"
                    QueryIcon="Find"
                    QuerySubmitted="CommandSearch_QuerySubmitted" />
            </Grid>
        </Border>

        <Border
            x:Name="ToolShelfHost"
            Grid.Row="2"
            Height="64"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="8,4">
                <StackPanel x:Name="DrawToolShelf" Orientation="Horizontal" Spacing="2">
                    <Button x:Uid="LineShelfButton" Tag="LINE" Click="RunCommand_Click" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="╱" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="LineToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="L" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="PolylineShelfButton" Tag="PLINE" Click="RunCommand_Click" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⌁" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="PolylineToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="PL" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="RectangleShelfButton" Tag="RECTANGLE" Click="RunCommand_Click" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="▭" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="RectangleToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="REC" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="CircleShelfButton" Tag="CIRCLE" Click="RunCommand_Click" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="○" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="CircleToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="C" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="ArcShelfButton" Tag="ARC" Click="RunCommand_Click" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="◜" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="ArcToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="A" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="44" Margin="4,6" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button x:Uid="HatchShelfButton" IsEnabled="False" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="▧" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="HatchToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="H" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="BoundaryShelfButton" IsEnabled="False" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⬚" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="BoundaryToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="BO" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="RayShelfButton" IsEnabled="False" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="↗" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="RayToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="RAY" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="ConstructionShelfButton" IsEnabled="False" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="＋" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="ConstructionToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="XL" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="ViewToolShelf" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Uid="ResetViewShelfButton" Tag="RESETVIEW" Click="RunCommand_Click" Style="{StaticResource ToolShelfButtonStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="↺" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="ResetViewToolLabel" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="RV" FontSize="8" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock
                    x:Name="ToolShelfHintText"
                    x:Uid="ToolShelfHintText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    FontSize="10"
                    Opacity="0.65" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="304" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <StackPanel Margin="8,8,8,0" Spacing="4">
                        <Button x:Uid="SelectRailButton" IsEnabled="False" Style="{StaticResource ToolRailButtonStyle}">
                            <TextBlock Text="↖" FontSize="16" />
                        </Button>
                        <Button x:Uid="LineRailButton" Tag="LINE" Click="RunCommand_Click" Style="{StaticResource ToolRailButtonStyle}">
                            <TextBlock Text="╱" FontSize="16" />
                        </Button>
                        <Button x:Uid="PolylineRailButton" Tag="PLINE" Click="RunCommand_Click" Style="{StaticResource ToolRailButtonStyle}">
                            <TextBlock Text="⌁" FontSize="16" />
                        </Button>
                        <Button x:Uid="MoveRailButton" IsEnabled="False" Style="{StaticResource ToolRailButtonStyle}">
                            <TextBlock Text="✥" FontSize="16" />
                        </Button>
                        <Button x:Uid="CopyRailButton" IsEnabled="False" Style="{StaticResource ToolRailButtonStyle}">
                            <TextBlock Text="⧉" FontSize="16" />
                        </Button>
                        <Button x:Uid="OffsetRailButton" IsEnabled="False" Style="{StaticResource ToolRailButtonStyle}">
                            <TextBlock Text="⇆" FontSize="16" />
                        </Button>
                        <Button x:Uid="TrimRailButton" IsEnabled="False" Style="{StaticResource ToolRailButtonStyle}">
                            <TextBlock Text="⌇" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <Button
                        x:Uid="MoreRailButton"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        Style="{StaticResource ToolRailButtonStyle}">
                        <TextBlock Text="•••" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="RectangleMoreItem" Tag="RECTANGLE" Click="RunCommand_Click" />
                                <MenuFlyoutItem x:Uid="CircleMoreItem" Tag="CIRCLE" Click="RunCommand_Click" />
                                <MenuFlyoutItem x:Uid="ArcMoreItem" Tag="ARC" Click="RunCommand_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="UndoMoreItem" x:Uid="UndoMoreItem" Tag="UNDO" Click="RunCommand_Click" />
                                <MenuFlyoutItem x:Name="RedoMoreItem" x:Uid="RedoMoreItem" Tag="REDO" Click="RunCommand_Click" />
                                <MenuFlyoutItem x:Uid="ClearMoreItem" Tag="CLEAR" Click="RunCommand_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="ResetViewMoreItem" Tag="RESETVIEW" Click="RunCommand_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <ContentControl
                x:Name="ViewportHost"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

            <Border
                Grid.Column="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="12,7,0,7">
                        <ToggleButton x:Name="PropertiesTabButton" x:Uid="PropertiesTabButton" IsChecked="True" Style="{StaticResource InspectorTabStyle}" />
                        <ToggleButton x:Uid="LayersTabButton" IsEnabled="False" Style="{StaticResource InspectorTabStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Padding="16" Spacing="12">
                        <TextBlock x:Uid="NoSelectionText" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Uid="SelectionUnavailableText" FontSize="11" Opacity="0.62" TextWrapping="Wrap" />
                        <TextBlock x:Uid="DocumentSectionText" Margin="0,12,0,0" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />

                        <Grid Height="28">
                            <TextBlock x:Uid="EntityCountLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.65" />
                            <TextBlock x:Name="EntityCountValue" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="11" />
                        </Grid>
                        <Grid Height="28">
                            <TextBlock x:Uid="ActiveCommandLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.65" />
                            <TextBlock x:Name="ActiveCommandValue" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="11" />
                        </Grid>
                        <Grid Height="28">
                            <TextBlock x:Uid="UndoAvailableLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.65" />
                            <TextBlock x:Name="UndoAvailableValue" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                        </Grid>
                        <Grid Height="28">
                            <TextBlock x:Uid="RedoAvailableLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.65" />
                            <TextBlock x:Name="RedoAvailableValue" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                        </Grid>

                        <Border
                            Margin="0,16,0,0"
                            Padding="10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock x:Uid="V04FoundationHint" FontSize="10" Opacity="0.62" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="12,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="CommandPrompt" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontWeight="SemiBold" />
                <TextBox
                    x:Name="CommandInput"
                    x:Uid="CommandInput"
                    Grid.Column="1"
                    Height="32"
                    Padding="4,2"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Cascadia Mono"
                    KeyDown="CommandInput_KeyDown" />
                <TextBlock
                    x:Name="ModeText"
                    Grid.Column="2"
                    MaxWidth="360"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    FontSize="10"
                    Opacity="0.65" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid Padding="12,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CoordinateText"
                    VerticalAlignment="Center"
                    Text="X 0.00  Y 0.00"
                    FontFamily="Cascadia Mono"
                    FontSize="10"
                    Opacity="0.65" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Uid="SnapStatusButton" IsEnabled="False" Style="{StaticResource ShellMenuButtonStyle}" FontSize="10" Padding="7,2" MinHeight="20" />
                    <Button x:Uid="GridStatusButton" IsEnabled="False" Style="{StaticResource ShellMenuButtonStyle}" FontSize="10" Padding="7,2" MinHeight="20" />
                    <Button x:Uid="OrthoStatusButton" IsEnabled="False" Style="{StaticResource ShellMenuButtonStyle}" FontSize="10" Padding="7,2" MinHeight="20" />
                    <Button x:Uid="PolarStatusButton" IsEnabled="False" Style="{StaticResource ShellMenuButtonStyle}" FontSize="10" Padding="7,2" MinHeight="20" />
                    <Button x:Uid="OsnapStatusButton" IsEnabled="False" Style="{StaticResource ShellMenuButtonStyle}" FontSize="10" Padding="7,2" MinHeight="20" />
                    <Button x:Uid="OtrackStatusButton" IsEnabled="False" Style="{StaticResource ShellMenuButtonStyle}" FontSize="10" Padding="7,2" MinHeight="20" />
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="10" Opacity="0.65" />
                    <TextBlock Text="mm" VerticalAlignment="Center" FontSize="10" Opacity="0.65" />
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="UCAD v0.3.5" VerticalAlignment="Center" FontSize="10" Opacity="0.65" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
