<Window
    x:Class="UCAD.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:UCAD.Views"
    Title="UCAD — Urban Computer-Aided Design">

    <Grid RowDefinitions="Auto,*,Auto">
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="Line" Click="Line_Click" />
            <AppBarButton Icon="Delete" Label="Clear" Click="Clear_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Refresh" Label="Reset view" Click="ResetView_Click" />
        </CommandBar>

        <views:CadViewport x:Name="Viewport" Grid.Row="1" />

        <Border Grid.Row="2" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="ModeText" Text="READY" FontFamily="Cascadia Mono" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="UCAD v0.1 · Foundation Preview" Opacity="0.7" />
                <TextBlock x:Name="CoordinateText" Grid.Column="2" Text="X 0.00  Y 0.00" FontFamily="Cascadia Mono" />
            </Grid>
        </Border>
    </Grid>
</Window>
