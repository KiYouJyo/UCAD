<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PR #19 acceptance visual contract.
         The drawing canvas deliberately keeps the CAD palette from UcadDesignTokens.xaml;
         only the application chrome and non-canvas surfaces are overridden here. -->

    <!-- Deep-teal dark defaults. MainWindow.Pr19AcceptanceUi applies the matching
         light-teal palette when Light/System-Light is active. -->
    <SolidColorBrush x:Key="UcadAppBackgroundBrush" Color="#0F1D1F" />
    <SolidColorBrush x:Key="UcadTitleBarBrush" Color="#102426" />
    <SolidColorBrush x:Key="UcadCategoryBarBrush" Color="#133033" />
    <SolidColorBrush x:Key="UcadToolShelfBrush" Color="#10282A" />
    <SolidColorBrush x:Key="UcadNavigationBrush" Color="#102527" />
    <SolidColorBrush x:Key="UcadCardBrush" Color="#153235" />
    <SolidColorBrush x:Key="UcadAboutCardBrush" Color="#143033" />
    <SolidColorBrush x:Key="UcadPanelBrush" Color="#11292B" />
    <SolidColorBrush x:Key="UcadOverlayBrush" Color="#0F1D1F" />
    <SolidColorBrush x:Key="UcadStatusBarBrush" Color="#133033" />
    <SolidColorBrush x:Key="UcadControlFillBrush" Color="#1D3A3D" />
    <SolidColorBrush x:Key="UcadControlFillSubtleBrush" Color="#173235" />
    <SolidColorBrush x:Key="UcadControlFillStrongBrush" Color="#143033" />

    <SolidColorBrush x:Key="UcadTextPrimaryBrush" Color="#F0F7F7" />
    <SolidColorBrush x:Key="UcadTextSecondaryBrush" Color="#A9BBBC" />
    <SolidColorBrush x:Key="UcadTextTertiaryBrush" Color="#82999B" />
    <SolidColorBrush x:Key="UcadTextDisabledBrush" Color="#62777A" />

    <SolidColorBrush x:Key="UcadAccentBrush" Color="#2E6F73" />
    <SolidColorBrush x:Key="UcadAccentSelectedBrush" Color="#397F83" />
    <SolidColorBrush x:Key="UcadAboutMarkBrush" Color="#397F83" />
    <SolidColorBrush x:Key="UcadAccentHoverBrush" Color="#498F93" />
    <SolidColorBrush x:Key="UcadAccentTextBrush" Color="#70C1C4" />
    <SolidColorBrush x:Key="UcadAccentStrokeBrush" Color="#5970C1C4" />
    <SolidColorBrush x:Key="UcadCategorySelectedBrush" Color="#24484B" />
    <SolidColorBrush x:Key="UcadAccentBrightBrush" Color="#70C1C4" />

    <SolidColorBrush x:Key="UcadDividerBrush" Color="#355052" />
    <SolidColorBrush x:Key="UcadCardBorderBrush" Color="#99506A6C" />
    <SolidColorBrush x:Key="UcadStartActionBorderBrush" Color="#BF506A6C" />
    <SolidColorBrush x:Key="UcadStartTemplateBorderBrush" Color="#80506A6C" />
    <SolidColorBrush x:Key="UcadAboutCardBorderBrush" Color="#506A6C" />
    <SolidColorBrush x:Key="UcadControlBorderBrush" Color="#506A6C" />
    <SolidColorBrush x:Key="UcadDividerSoftBrush" Color="#263F41" />

    <!-- Figma title/tab proportions: roomy browser-style document tabs rather than
         the legacy 190x34 compact strip. -->
    <GridLength x:Key="UcadTitleBarHeight">60</GridLength>
    <x:Double x:Key="UcadDocumentTabWidth">280</x:Double>
    <x:Double x:Key="UcadDocumentTabHeight">48</x:Double>

    <!-- Keep layout dimensions while allowing WinUI's native Button/ToggleButton
         theme styles to own Background, Foreground, Border and visual states. -->
    <Style x:Key="UcadShellMenuButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="UcadCategoryButtonStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="UcadToolShelfButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="74" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="UcadToolRailButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="UcadInspectorTabStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="UcadStatusButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="UcadSettingsNavButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="196" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="11" />
    </Style>
</ResourceDictionary>
