<UserControl
    x:Class="UCAD.Views.CadViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <canvas:CanvasControl
            x:Name="Canvas"
            Draw="Canvas_Draw"
            PointerMoved="Canvas_PointerMoved"
            PointerPressed="Canvas_PointerPressed"
            PointerReleased="Canvas_PointerReleased"
            PointerCaptureLost="Canvas_PointerCaptureLost"
            PointerExited="Canvas_PointerExited"
            PointerWheelChanged="Canvas_PointerWheelChanged" />
    </Grid>
</UserControl>
