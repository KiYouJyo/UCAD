<UserControl
    x:Class="UCAD.Controls.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Width="{StaticResource UcadSettingsCardWidth}"
        Height="{StaticResource UcadSettingsCardHeight}"
        Background="{StaticResource UcadCardBrush}"
        BorderBrush="{StaticResource UcadCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource UcadRadiusCard}">
        <Grid Padding="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="36"
                Height="36"
                VerticalAlignment="Center"
                Background="{StaticResource UcadControlFillSubtleBrush}"
                CornerRadius="5">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                    FontSize="16"
                    Foreground="{StaticResource UcadTextSecondaryBrush}" />
            </Border>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Spacing="3">
                <TextBlock
                    Text="{x:Bind Title, Mode=OneWay}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource UcadTextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{x:Bind Description, Mode=OneWay}"
                    FontSize="9"
                    Foreground="{StaticResource UcadTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ContentPresenter
                Grid.Column="3"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Content="{x:Bind ActionContent, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
